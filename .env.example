# Tyla Gen Configuration
TYLA_API_KEY=your_secure_api_key_here
TYLA_API_URL=http://localhost:8000
TYLA_PORT=8000
TYLA_HOST=0.0.0.0

# Model Configuration
TYLA_MODEL=phi-2
TYLA_MODEL_PATH=./models/phi-2.gguf
TYLA_QUANTIZATION=q4_k_m

# Inference Settings
TYLA_MAX_TOKENS=2048
TYLA_TEMPERATURE=0.7
TYLA_TOP_P=0.95

# Agent Configuration
TYLA_AGENT_ENABLED=true
TYLA_AGENT_TIMEOUT=30

# Memory/Database
TYLA_DB_PATH=./data/tyla.db
TYLA_MEMORY_ENABLED=true

# RAG Configuration
TYLA_RAG_ENABLED=true
TYLA_KNOWLEDGE_PATH=./knowledge

# Safety & Ethics
TYLA_ETHICAL_MODE=true
TYLA_RESTRICTED_TOOLS_ENABLED=false
TYLA_SANDBOX_MODE=true
TYLA_OWNER_ID=tyladigital01
